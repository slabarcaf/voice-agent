# Copy to .env.local for local runs. Real values live in Vercel (vercel env pull .env.local).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LLM_SHARED_SECRET=
# Optional overrides
GROQ_FAST_MODEL=llama-3.3-70b-versatile
CLAUDE_SMART_MODEL=claude-sonnet-5-5
ALLOWED_ORIGINS=
VOICE_ENABLED=true
