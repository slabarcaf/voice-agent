{
  "functions": {
    "api/*.js": {
      "includeFiles": "{brain,eleven}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/web/demo.html"
    },
    {
      "source": "/api/llm/:rest*",
      "destination": "/api/llm"
    }
  ],
  "headers": [
    {
      "source": "/(demo|web/demo.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://santiagolabarca.vercel.app http://localhost:4322"
        }
      ]
    }
  ]
}
